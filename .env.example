# Copier ce fichier en .env et remplir.
DJANGO_SECRET_KEY=change-moi
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# En prod : DJANGO_CSRF_TRUSTED_ORIGINS=https://www.exemple.fr

NOM_BOUTIQUE=Ma Friperie
FRAIS_PORT_CENTIMES=590
PAYS_LIVRAISON=FR,BE,LU,CH

# Laisser vide = paiement simulé (dev). Clés de test : https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Donné par `stripe listen --forward-to localhost:8000/stripe/webhook/` en local
STRIPE_WEBHOOK_SECRET=
